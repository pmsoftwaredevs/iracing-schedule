IRCAL_DATABASE_URL=sqlite:///./iracing_calendar.db
IRCAL_BASE_URL=http://localhost:8000

IRCAL_SMTP_HOST=
IRCAL_SMTP_PORT=587
IRCAL_SMTP_USERNAME=
IRCAL_SMTP_PASSWORD=
IRCAL_SMTP_FROM_ADDRESS=iracing-calendar@localhost

# Optional overrides — all default to official, public, unauthenticated iRacing sources
# verified working at time of writing. No iRacing account credentials are used anywhere.
