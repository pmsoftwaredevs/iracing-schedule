# IRCAL_SCHEDULE_PDF_URL=https://members-assets.iracing.com/public/schedulepdf/SeasonSchedule.pdf
# IRCAL_SPECIAL_EVENTS_PAGE_URL=https://www.iracing.com/special-events/
